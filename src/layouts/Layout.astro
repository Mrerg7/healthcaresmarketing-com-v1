---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const DEFAULT_DESCRIPTION =
  'Healthcares Marketing helps healthcare organizations grow with clear strategy, patient acquisition, and brand presence.';

const {
  title = 'Healthcares Marketing',
  description = DEFAULT_DESCRIPTION,
  image = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/bc3af191-a2b4-437a-bf46-8de26a24db00/public',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Healthcares Marketing';
const ogImage = image;
const metaDescription = description.trim() || DEFAULT_DESCRIPTION;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <meta name="google-site-verification" content="IHzPomtaTymT5ZCVpVVr219HmHd9sCYs7zdJT4rG7R0" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href={canonicalURL} />
      </>
    )}

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Theme -->
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={noindex ? 'https://healthcaresmarketing.com/' : canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Healthcares Marketing" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Healthcares Marketing" />

    {/* Skip WebSite JSON-LD on error pages so /404 is not treated as an alternate homepage */}
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": siteName,
        "url": "https://healthcaresmarketing.com",
        "description": metaDescription,
        "image": ogImage,
        "publisher": {
          "@type": "Organization",
          "name": "Healthcares Marketing",
          "url": "https://healthcaresmarketing.com",
          "email": "erg@healthcaresmarketing.com"
        }
      })} />
    )}
  </head>
  <body class="bg-[var(--color-void)] text-[var(--color-ghost)]">
    <slot />
  </body>
</html>
