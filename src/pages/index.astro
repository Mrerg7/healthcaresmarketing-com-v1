---
import Layout from '../layouts/Layout.astro';

const IMAGE =
  'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/bc3af191-a2b4-437a-bf46-8de26a24db00/public';

const DESCRIPTION =
  'Healthcares Marketing helps healthcare organizations grow with clear strategy, patient acquisition, and brand presence.';
---

<Layout title="Healthcares Marketing" description={DESCRIPTION}>
  <main class="w-full bg-[var(--color-void)]">
    <!-- Full-bleed mystic hero: brand + line + CTA in one composition -->
    <section class="relative flex min-h-dvh w-full flex-col overflow-hidden">
      <div class="absolute inset-0 overflow-hidden">
        <img
          src={IMAGE}
          alt="Atmospheric brand visual for Healthcares Marketing"
          width="1920"
          height="1080"
          decoding="async"
          fetchpriority="high"
          class="mystic-image absolute inset-0 h-full w-full object-cover object-center drift-layer select-none"
          style="will-change: transform, opacity, filter;"
        />
      </div>

      <!-- Layered atmospheric overlays -->
      <div
        class="pointer-events-none absolute inset-0 fog-layer"
        style="background: radial-gradient(ellipse 80% 70% at 50% 40%, transparent 0%, rgba(5,5,8,0.55) 55%, rgba(5,5,8,0.92) 100%);"
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute inset-0"
        style="background: linear-gradient(to bottom, rgba(5,5,8,0.65) 0%, transparent 28%, transparent 55%, rgba(5,5,8,0.92) 100%);"
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute inset-0 opacity-40"
        style="background: radial-gradient(circle at 30% 20%, rgba(90,70,50,0.18), transparent 45%), radial-gradient(circle at 75% 70%, rgba(40,30,50,0.22), transparent 40%);"
        aria-hidden="true"
      ></div>

      <!-- Noise grain -->
      <div class="noise absolute inset-0 opacity-[0.07]" aria-hidden="true"></div>

      <!-- Subtle vignette edge -->
      <div
        class="pointer-events-none absolute inset-0 shadow-[inset_0_0_120px_rgba(0,0,0,0.75)]"
        aria-hidden="true"
      ></div>

      <!-- Brand + supporting line + CTA — visible copy for mobile / crawl trust -->
      <div
        class="cta-reveal relative z-20 mt-auto flex flex-col items-center px-6 pb-16 pt-24 text-center sm:pb-20"
      >
        <h1
          class="max-w-3xl text-[1.75rem] font-medium leading-tight tracking-[0.04em] text-[var(--color-ghost)] sm:text-4xl md:text-5xl"
        >
          Healthcares Marketing
        </h1>
        <p
          class="mt-4 max-w-xl text-base leading-relaxed text-[var(--color-whisper)] sm:text-lg"
        >
          Strategy and presence for healthcare brands that need to be found.
        </p>
        <a
          href="mailto:erg@healthcaresmarketing.com"
          class="group relative mt-8 inline-flex min-h-12 items-center gap-2 rounded-full border border-white/15 bg-black/40 px-8 py-3.5 text-sm font-medium tracking-[0.22em] uppercase text-[var(--color-ghost)] backdrop-blur-md transition-all duration-700 hover:border-white/30 hover:bg-black/55 hover:shadow-[0_0_40px_rgba(180,160,140,0.15)] focus:outline-none focus-visible:ring-1 focus-visible:ring-white/30"
          aria-label="Email Healthcares Marketing at erg@healthcaresmarketing.com"
        >
          <span class="relative z-10">Inquire</span>
          <span
            class="absolute inset-0 rounded-full bg-gradient-to-r from-transparent via-white/5 to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100"
            aria-hidden="true"
          ></span>
        </a>
      </div>
    </section>

    <!-- Footer disclaimer -->
    <footer class="footer-reveal relative z-30 px-5 pb-8 pt-6 sm:px-8 sm:pb-10">
      <p
        class="mx-auto max-w-2xl text-center text-sm leading-relaxed tracking-wide text-white/55"
      >
        Information on this site is general and may change. It is not an offer of services, a
        commitment to deploy, or a guarantee of outcomes. References to technologies or results are
        based on publicly available information and are subject to change.
      </p>
    </footer>
  </main>
</Layout>
